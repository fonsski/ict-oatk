# ============================================================
# ICT Help — боевое окружение
# Скопируйте в корень проекта как .env и заполните значения.
# ============================================================

APP_NAME="ICT Help"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Omsk
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru

# Адрес, по которому система открывается в браузере.
# Если работаете по имени — укажите его, иначе IP виртуалки.
APP_URL=http://ict.college.local

# ------------------------------------------------------------
# База данных
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ict_help
DB_USERNAME=ict_help
DB_PASSWORD=

# ------------------------------------------------------------
# Инфраструктура
# ------------------------------------------------------------
LOG_CHANNEL=daily
LOG_LEVEL=warning

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# ------------------------------------------------------------
# WebSocket (Reverb) — живые уведомления
# Ключи сгенерируйте: php artisan reverb:install
# ------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="127.0.0.1"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------------------------
# Почта (восстановление пароля, уведомления)
# ------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@college.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
# Сотрудники отдела
# Вход в систему по номеру телефона — без номера учётка не заводится.
# Формат любой: +79001234567, 8 (900) 123-45-67, 9001234567.
# ------------------------------------------------------------
STAFF_KHOROBROV_PHONE=
STAFF_SINEGUBOV_PHONE=
STAFF_GREBENSHCHIKOV_PHONE=
STAFF_KUNGFU_PHONE=

# Необязательно: общий стартовый пароль. Если оставить пустым,
# каждому сотруднику сгенерируется свой и покажется один раз при сидировании.
STAFF_DEFAULT_PASSWORD=
