[Unit]
Description=ICT Help — WebSocket-сервер Reverb (живые уведомления)
After=network.target mysql.service
Requires=mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ict-help
ExecStart=/usr/bin/php /var/www/ict-help/artisan reverb:start --host=0.0.0.0 --port=8080
Restart=always
RestartSec=5
StandardOutput=append:/var/www/ict-help/storage/logs/reverb.log
StandardError=append:/var/www/ict-help/storage/logs/reverb.log

[Install]
WantedBy=multi-user.target
