[Unit]
Description=ICT Help — планировщик Laravel (запускается таймером раз в минуту)
After=network.target mysql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/ict-help
ExecStart=/usr/bin/php /var/www/ict-help/artisan schedule:run
StandardOutput=append:/var/www/ict-help/storage/logs/scheduler.log
StandardError=append:/var/www/ict-help/storage/logs/scheduler.log
