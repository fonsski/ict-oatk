APP_NAME="ICT Help"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_PORT=80

# Localization and timezone settings
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU
APP_TIMEZONE=Asia/Omsk

# Maintenance mode settings
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP CLI server settings
PHP_CLI_SERVER_WORKERS=4

# Hashing settings
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (значения по умолчанию — для Laravel Sail)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ict
DB_USERNAME=sail
DB_PASSWORD=password

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=false # Set to true if using HTTPS

# General settings
BROADCAST_CONNECTION=reverb

# Reverb WebSocket server (php artisan reverb:start).
# Сгенерируйте свои значения: php artisan reverb:install либо вручную.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# В Sail сервер (контейнер laravel.test) публикует события в Reverb по имени
# сервиса из docker-compose. Браузеру нужен адрес хоста — см. VITE_REVERB_HOST.
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http

# Адрес, который слушает сам процесс reverb:start.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Браузер подключается к проброшенному порту Reverb на хост-машине.
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache settings
CACHE_STORE=file
# CACHE_PREFIX=

# Memcached
MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail settings (по умолчанию — Mailpit из Laravel Sail)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Реальный SMTP (например, Gmail — нужен пароль приложения, не обычный).
# Подробности: config/gmail_smtp_setup.md
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_gmail_address
# MAIL_PASSWORD=your_gmail_app_password
# На порту 587 шифрование включается само (STARTTLS);
# для порта 465 укажите MAIL_SCHEME=smtps.
# MAIL_SCHEME=smtp
# MAIL_FROM_ADDRESS=your_gmail_address
# MAIL_FROM_NAME="${APP_NAME}"

# Сотрудники отдела (StaffUserSeeder, см. config/staff.php).
# Вход в систему идёт по номеру телефона — без номера учётка не заводится.
# Формат любой: +79001234567, 8 (900) 123-45-67, 9001234567.
STAFF_KHOROBROV_PHONE=
STAFF_SINEGUBOV_PHONE=
STAFF_GREBENSHCHIKOV_PHONE=
STAFF_KUNGFU_PHONE=

# Почта сотрудников — необязательна, используется для восстановления пароля.
STAFF_KHOROBROV_EMAIL=
STAFF_SINEGUBOV_EMAIL=
STAFF_GREBENSHCHIKOV_EMAIL=
STAFF_KUNGFU_EMAIL=

# Необязательно: общий стартовый пароль. Если пусто — каждому сотруднику
# сгенерируется свой и покажется один раз при сидировании.
STAFF_DEFAULT_PASSWORD=

# AWS settings (if used)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Laravel Sail
WWWGROUP=1000
WWWUSER=1000
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

# Docker port forwarding
FORWARD_DB_PORT=3306
VITE_PORT=5173

# Vite settings
VITE_APP_NAME="${APP_NAME}"
VITE_ENABLED=true

# Additional security for production
# Generate APP_KEY with: php artisan key:generate
# APP_KEY=base64:your_generated_key
SANCTUM_STATEFUL_DOMAINS=localhost
